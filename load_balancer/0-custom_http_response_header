#!/usr/bin/env bash
# Install Nginx with an X-Served-By hostname header, redirect, and custom 404 page.
set -e

if [ "$EUID" -ne 0 ]; then
    exec sudo bash "$0" "$@"
fi

apt-get update
apt-get install -y nginx

mkdir -p /var/www/html /etc/nginx/sites-available /etc/nginx/sites-enabled
printf '%s\n' 'Holberton School for the win!' > /var/www/html/index.html
printf '%s\n' "Ceci n'est pas une page" > /var/www/html/404.html

# The quoted heredoc preserves Nginx variables for Nginx to evaluate.
cat > /etc/nginx/sites-available/default <<'NGINX'
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    root /var/www/html;
    index index.html;
    add_header X-Served-By $hostname always;
    error_page 404 /404.html;

    location = /404.html {
        internal;
    }

    location /redirect_me {
        return 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
NGINX

ln -sf /etc/nginx/sites-available/default /etc/nginx/sites-enabled/default
nginx -t
