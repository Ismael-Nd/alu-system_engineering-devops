#!/usr/bin/env bash
# Install HAProxy with init-script support and roundrobin across both web servers.

export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get install -y haproxy curl

# Enable the Ubuntu package's init script without duplicating the setting.
if grep -q '^ENABLED=' /etc/default/haproxy; then
    sed -i 's/^ENABLED=.*/ENABLED=1/' /etc/default/haproxy
else
    printf '\nENABLED=1\n' >> /etc/default/haproxy
fi

cat > /etc/haproxy/haproxy.cfg <<'HAPROXY'
global
    log /dev/log local0
    user haproxy
    group haproxy
    daemon

defaults
    log global
    mode http
    option httplog
    option dontlognull
    timeout connect 5s
    timeout client 50s
    timeout server 50s

frontend web_frontend
    bind *:80
    default_backend web_backend

backend web_backend
    balance roundrobin
    server web-01 3.10.209.204:80 check
    server web-02 16.60.159.142:80 check
HAPROXY

haproxy -c -f /etc/haproxy/haproxy.cfg
service haproxy restart || service haproxy start

seen_web_01=0
seen_web_02=0
for ((attempt = 0; attempt < 20; attempt++)); do
    response=$(curl -fsSI --max-time 2 http://127.0.0.1/ || true)
    case "$response" in
        *web-01*) seen_web_01=1 ;;
        *web-02*) seen_web_02=1 ;;
    esac
    if [ "$seen_web_01" -eq 1 ] && [ "$seen_web_02" -eq 1 ]; then
        printf 'web-01 and web-02 are ready\n'
        exit 0
    fi
    sleep 1
done

printf 'HAProxy configured for web-01 and web-02\n'
