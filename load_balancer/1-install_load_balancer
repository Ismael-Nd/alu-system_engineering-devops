#!/usr/bin/env bash
# Install HAProxy with init-script support and roundrobin across both web servers.
set -e

if [ "$EUID" -ne 0 ]; then
    exec sudo bash "$0" "$@"
fi

apt-get update
apt-get install -y haproxy

# Enable the Ubuntu package's init script without duplicating the setting.
if grep -q '^ENABLED=' /etc/default/haproxy; then
    sed -i 's/^ENABLED=.*/ENABLED=1/' /etc/default/haproxy
else
    printf '\nENABLED=1\n' >> /etc/default/haproxy
fi

cat > /etc/haproxy/haproxy.cfg <<'HAPROXY'
global
    log /dev/log local0
    user haproxy
    group haproxy
    daemon

defaults
    log global
    mode http
    option httplog
    option dontlognull
    timeout connect 5s
    timeout client 50s
    timeout server 50s

frontend web_frontend
    bind *:80
    default_backend web_backend

backend web_backend
    balance roundrobin
    server 7303-web-01 3.10.209.204:80 check
    server 7303-web-02 16.60.159.142:80 check
HAPROXY

haproxy -c -f /etc/haproxy/haproxy.cfg
