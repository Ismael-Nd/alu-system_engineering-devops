#!/usr/bin/env bash
# Install UFW and permit only SSH, HTTP, and HTTPS TCP connections inbound.
set -e

export DEBIAN_FRONTEND=noninteractive
apt-get update || true
apt-get install -y ufw

ufw allow 22/tcp
ufw allow 80/tcp
ufw allow 443/tcp
ufw default deny incoming
ufw default allow outgoing
ufw --force enable
ufw status verbose
