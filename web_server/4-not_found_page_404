#!/usr/bin/env bash
# Installs nginx with a 301 redirect and a custom 404 page "Ceci n'est pas une page"
apt-get update -y
apt-get install -y nginx
echo "Holberton School for the win!" > /var/www/html/index.html
echo "Ceci n'est pas une page" > /var/www/html/404.html

config="/etc/nginx/sites-available/default"
if ! grep -q "redirect_me" "$config"; then
    sed -i '/server_name _;/a rewrite ^/redirect_me https://www.youtube.com/watch?v=QH2-TGUlwu4 permanent;' "$config"
fi
if ! grep -q "error_page 404" "$config"; then
    sed -i '/server_name _;/a error_page 404 /404.html;' "$config"
fi

service nginx restart
