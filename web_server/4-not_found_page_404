#!/usr/bin/env bash
# Install Nginx with a permanent redirect and a custom HTTP 404 page.
set -e

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y nginx

mkdir -p /var/www/html /etc/nginx/sites-available /etc/nginx/sites-enabled
printf '%s\n' 'Holberton School for the win!' > /var/www/html/index.html
printf '%s\n' "Ceci n'est pas une page" > /var/www/html/404.html

# Keep this script standalone; use the artwork when supplied alongside it.
script_dir=$(cd -- "$(dirname -- "$0")" && pwd)
artwork="$script_dir/5-design_a_beautiful_404_page.html"
if [ -f "$artwork" ]; then
    install -m 644 "$artwork" /var/www/html/404.html
    install -m 644 "$artwork" /var/www/html/5-design_a_beautiful_404_page.html
fi

cat > /etc/nginx/sites-available/default <<'NGINX'
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    root /var/www/html;
    index index.html;
    add_header X-Served-By $hostname always;
    error_page 404 /404.html;

    location = /404.html {
        internal;
    }

    location /redirect_me {
        return 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
NGINX

ln -sf /etc/nginx/sites-available/default /etc/nginx/sites-enabled/default
nginx -t
service nginx restart
