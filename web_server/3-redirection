#!/usr/bin/env bash
# Install Nginx and configure /redirect_me to return a permanent redirect.
set -e

export DEBIAN_FRONTEND=noninteractive
apt-get update || true
apt-get install -y nginx

printf '%s\n' 'Holberton School for the win!' > /var/www/html/index.html

config=/etc/nginx/sites-available/default
sed -i -f /dev/stdin "$config" <<'SED'
/^[[:space:]]*listen \[::\]:80 default_server;/d
/^[[:space:]]*server_name _;[[:space:]]*$/c\
    server_name _;\
    add_header X-Served-By $hostname always;\
    location /redirect_me {\
        return 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;\
    }
SED

nginx -t
service nginx restart || nginx
